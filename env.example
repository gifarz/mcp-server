# Wyntrax API (the Next.js app's /api/mcp/v1/* routes)
BASE_URL=https://wyntrax.xyz/api/mcp/v1
BASE_URL_DEV=http://localhost:3000/api/mcp/v1
MCP_SECRET=server_secret_here

# Prisma (shared with the Wyntrax web app — same DB, includes the
# McpWalletRequest table required by @wyntraxyz/mcp-wallet's PrismaAdapter)
PRISMA_CLIENT_PATH=../wyntrax/node_modules/.prisma/client

# MCP Server
HTTP_PORT=3001
MCP_SERVER_URL=https://mcp.wyntrax.xyz

# Shared secret trusted from the Wyntrax Next.js app's internal proxy
# (see src/oauth/middleware.js) — lets it forward an already-verified
# X-User-Id instead of this server re-validating a bearer token.
MCP_INTERNAL_SECRET=internal_secret_here

# --- @wyntraxyz/mcp-wallet ---------------------------------------------------

# Where the payment-approval page lives (the Wyntrax web app's
# /wallet/approve/[id], built with @wyntraxyz/mcp-wallet-ui's <WalletApproval />)
WALLET_APPROVAL_URL=https://wyntrax.xyz/wallet/approve

# Optional: use Redis (@wyntraxyz/mcp-wallet-adapters RedisAdapter) instead
# of Prisma for wallet-bridge request storage — recommended once this runs
# as more than one process. Leave unset to use Prisma.
REDIS_URL=

# RPC endpoints used to verify payment txs and wallet-login signatures.
# Public endpoints are used if these are left unset, but a dedicated
# provider (Alchemy/Infura/Helius) is recommended for production.
ETH_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
SOLANA_RPC_URL=
